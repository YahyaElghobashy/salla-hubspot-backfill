# Copy to .env — the setup wizard (python serve.py) writes this for you.
# Never commit .env.
HUBSPOT_ACCESS_TOKEN=pat-xxx-your-private-app-token
RELAY_SECRET=the-random-string-you-put-in-the-make-relay-filters

# --- v2.2 alerting (all optional; unset channels are skipped gracefully) ---
# Slack app bot token + target channel for outage/credit alerts
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# SMTP for email alerts (Gmail/Workspace needs an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
# Read-only Make API token (organizations:read, scenarios:read, hooks:read)
MAKE_API_TOKEN=
